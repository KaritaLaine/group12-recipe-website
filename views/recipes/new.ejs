<%- contentFor('body') %>

  <div>
    <h1>Add a new recipe</h1>

    <form action="/recipes" method="POST" enctype="multipart/form-data">
      <div>
        <label>Title</label><br />
        <input name="title" type="text" required style="width:300px;" />
      </div>

      <div">
        <label>Time to cook (minutes)</label><br />
        <input name="timeToCook" type="number" min="1" required style="width:120px;" />
  </div>

  <div>
    <label>Ingredients</label><br />

    <ul id="ingredientsList"></ul>

    <div>
      <input id="ingredientInput" type="text" placeholder="Add ingredient..." style="width:300px;" />
      <button id="addIngredientBtn" type="button">+</button>
    </div>

    <textarea id="ingredientsTextarea" name="ingredients" rows="6" cols="50" style="display:none;"></textarea>
  </div>

  <div>
    <label>Steps</label><br />

    <ol id="stepsList"></ol>

    <div>
      <input id="stepInput" type="text" placeholder="Add step..." style="width:300px;" />
      <button id="addStepBtn" type="button">+</button>
    </div>

    <textarea id="stepsTextarea" name="steps" rows="6" cols="50" style="display:none;"></textarea>
  </div>

  <script src="/js/new.js"></script>

  <div>
    <label>Image</label><br />
    <input name="image" type="file" accept="image/*" />
  </div>

  <button type="submit">Save recipe</button>
  <a href="/">Cancel</a>
  </form>
  </div>