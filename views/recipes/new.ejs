<%- contentFor('body') %>

<div class="wrapper">
  <div class="form-container">
    <h1>Add a new recipe</h1>

    <form class="login-form" action="/recipes" method="POST" enctype="multipart/form-data">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required />

      <label for="timeToCook">Time to cook (minutes)</label>
      <input id="timeToCook" name="timeToCook" type="number" min="1" required />

      <label>Ingredients</label>
      <ul id="ingredientsList"></ul>

      <div style="display:flex; gap:1rem; width:100%; align-items:center;">
        <input
          id="ingredientInput"
          type="text"
          placeholder="Add ingredient..."
          style="flex:1;"
        />
        <button id="addIngredientBtn" type="button" class="list-btn">+</button>
      </div>

      <textarea
        id="ingredientsTextarea"
        name="ingredients"
        rows="6"
        cols="50"
        style="display:none;"
      ></textarea>

      <label>Steps</label>
      <ol id="stepsList"></ol>

      <div style="display:flex; gap:1rem; width:100%; align-items:center;">
        <input
          id="stepInput"
          type="text"
          placeholder="Add step..."
          style="flex:1;"
        />
        <button id="addStepBtn" type="button" class="list-btn">+</button>
      </div>

      <textarea
        id="stepsTextarea"
        name="steps"
        rows="6"
        cols="50"
        style="display:none;"
      ></textarea>

      <label for="image">Image</label>
      <input id="image" name="image" type="file" accept="image/*" />

      <button class="btn" type="submit">Save recipe</button>

      <p class="action-link">
        <a href="/">Cancel</a>
      </p>
    </form>
  </div>
</div>

<script src="/js/new.js"></script>
