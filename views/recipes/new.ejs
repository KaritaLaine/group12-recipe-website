<%- contentFor('body') %>

  <div>
    <h1>Add a new recipe</h1>

    <form action="/recipes" method="POST">
      <div style="margin-bottom:12px;">
        <label>Title</label><br />
        <input name="title" type="text" required style="width:300px;" />
      </div>

      <div style="margin-bottom:12px;">
        <label>Time to cook (minutes)</label><br />
        <input name="timeToCook" type="number" min="1" required style="width:120px;" />
      </div>

      <div style="margin-bottom:12px;">
        <label>Ingredients (one per line)</label><br />
        <textarea name="ingredients" rows="6" cols="50"></textarea>
      </div>

      <div style="margin-bottom:12px;">
        <label>Steps (one per line)</label><br />
        <textarea name="steps" rows="6" cols="50"></textarea>
      </div>

      <button type="submit">Save recipe</button>
      <a href="/">Cancel</a>
    </form>
  </div>