<!-- views/recipes/index.ejs -->
<%- contentFor('body') %>

<div>
  <div class="recipes-header">
    <div class="recipes-header-top">
      <h1>Recipes</h1>

      <% if (loggedIn) { %>
        <a href="/recipes/new" class="btn">+ Add recipe</a>
      <% } %>
    </div>

    <% if (loggedIn) { %>
    <p>Welcome, <%= currentUser.userName %>!</p>
    <% } %>
  </div>

  <% if (!recipes || recipes.length===0) { %>
  <p>No recipes yet. Add your first one!</p>

  <% } else { %>
  <div class="recipe-container">
    <% recipes.forEach(r=> { %>
    <div class="recipe-card">
      <a href="/recipes/<%= r._id %>">
        <% if (r.image) { %>
        <img src="<%= r.image %>" alt="<%= r.title %>" />
        <% } %>

        <div class="recipe-row">
          <div class="left">
            <h3><%= r.title %></h3>
            <p>⏱ <%= r.timeToCook %> min</p>
          </div>

          <div class="right">
            <p>Reviews:</p>
          </div>
        </div>
      </a>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>
