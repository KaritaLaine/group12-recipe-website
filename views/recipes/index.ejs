<!-- views/recipes/index.ejs -->
<%- contentFor('body') %>

  <div>
    <h1>Recipes</h1>

    <a href="/recipes/new">➕ Add recipe</a>

    <% if (!recipes || recipes.length===0) { %>
      <p>No recipes yet. Add your first one!</p>
      <% } else { %>
        <div>
          <% recipes.forEach(r=> { %>
            <a href="/recipes/<%= r._id %>">

              <% if (r.image) { %>
                <img src="/images/<%= r.image %>" alt="<%= r.title %>">
                <% } %>

                  <h3>
                    <%= r.title %>
                  </h3>
                  <p>⏱ <%= r.timeToCook %> min</p>
            </a>
            <% }) %>
        </div>
        <% } %>
  </div>